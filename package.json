{
  "name": "enterprise-lms",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "db:generate": "pnpm --filter @lms/api db:generate",
    "db:migrate": "pnpm --filter @lms/api db:migrate",
    "db:seed": "pnpm --filter @lms/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.18",
      "@types/react-dom": "^18.3.5"
    }
  }
}
